# Copy to .env for local use (.env is git-ignored). Never commit real values.
# Shared password for the team demonstration. Required: the app refuses all
# dashboard/API access when this is unset.
PACT_DEMO_PASSWORD=change-me
# Optional: HMAC key for session cookies. If unset, a key is derived from the
# password. Render generates this automatically via render.yaml.
PACT_SESSION_SECRET=
# Optional: session lifetime in seconds (default 43200 = 12 hours).
PACT_SESSION_TTL_SECONDS=43200
